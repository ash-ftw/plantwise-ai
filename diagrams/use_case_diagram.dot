digraph UseCaseDiagram {
    rankdir=LR;
    fontname="Arial";
    node [fontname="Arial"];
    edge [fontname="Arial"];
    
    // Title
    labelloc="t";
    fontsize=18;
    
    // Actors
    subgraph cluster_actors {
        label="Actors";
        style=invis;
        
        Farmer [shape=box, style=rounded, label="Farmer"];
        Officer [shape=box, style=rounded, label="Agricultural Officer"];
        Admin [shape=box, style=rounded, label="System Admin"];
        AIEngine [shape=box, style=rounded, label="AI Engines"];
        System [shape=box, style=rounded, label="Disease Prediction System"];
    }
    
    // Use Cases grouped by subsystem
    subgraph cluster_auth {
        label="Authentication";
        
        UC_Register [shape=ellipse, label="Register Account"];
        UC_Login [shape=ellipse, label="Login"];
        UC_Logout [shape=ellipse, label="Logout"];
        UC_ViewProfile [shape=ellipse, label="View Profile"];
        UC_ChangePassword [shape=ellipse, label="Change Password"];
    }
    
    subgraph cluster_farmer {
        label="Farmer Features";
        
        UC_UploadImage [shape=ellipse, label="Upload Plant Image"];
        UC_GetPrediction [shape=ellipse, label="Get Disease Prediction"];
        UC_ViewHistory [shape=ellipse, label="View Prediction History"];
        UC_ViewTreatments [shape=ellipse, label="View Treatment\nRecommendations"];
        UC_DownloadPDF [shape=ellipse, label="Download Report PDF"];
        UC_ViewNotifications [shape=ellipse, label="View Notifications"];
    }
    
    subgraph cluster_officer {
        label="Officer Features";
        
        UC_ReviewPredictions [shape=ellipse, label="Review Pending\nPredictions"];
        UC_VerifyPrediction [shape=ellipse, label="Verify/Correct\nPrediction"];
        UC_FlagPrediction [shape=ellipse, label="Flag Prediction"];
        UC_AddTreatments [shape=ellipse, label="Add Treatment\nSuggestions"];
        UC_ViewStatistics [shape=ellipse, label="View Review\nStatistics"];
    }
    
    subgraph cluster_admin {
        label="Admin Features";
        
        UC_ManageUsers [shape=ellipse, label="Manage Users"];
        UC_AssignRoles [shape=ellipse, label="Assign User Roles"];
        UC_ToggleUserStatus [shape=ellipse, label="Activate/Deactivate\nUsers"];
        UC_DeleteUser [shape=ellipse, label="Delete User"];
        UC_ViewMetrics [shape=ellipse, label="View System Metrics"];
        UC_ViewAuditLogs [shape=ellipse, label="View Audit Logs"];
        UC_ManageModel [shape=ellipse, label="Manage AI Model"];
        UC_ToggleModel [shape=ellipse, label="Toggle Model Status"];
    }
    
    subgraph cluster_system {
        label="System Operations";
        
        UC_RunInference [shape=ellipse, label="Run Disease\nInference"];
        UC_StoreData [shape=ellipse, label="Store Prediction\nData"];
        UC_LogAudit [shape=ellipse, label="Log Audit Events"];
        UC_SendNotification [shape=ellipse, label="Send Notifications"];
    }
    
    // Farmer associations
    Farmer -> UC_Register;
    Farmer -> UC_Login;
    Farmer -> UC_Logout;
    Farmer -> UC_ViewProfile;
    Farmer -> UC_ChangePassword;
    Farmer -> UC_UploadImage;
    Farmer -> UC_GetPrediction;
    Farmer -> UC_ViewHistory;
    Farmer -> UC_ViewTreatments;
    Farmer -> UC_DownloadPDF;
    Farmer -> UC_ViewNotifications;
    
    // Officer associations (includes farmer features + officer features)
    Officer -> UC_Login;
    Officer -> UC_ViewProfile;
    Officer -> UC_UploadImage;
    Officer -> UC_ReviewPredictions;
    Officer -> UC_VerifyPrediction;
    Officer -> UC_FlagPrediction;
    Officer -> UC_AddTreatments;
    Officer -> UC_ViewStatistics;
    
    // Admin associations (all features)
    Admin -> UC_Login;
    Admin -> UC_ManageUsers;
    Admin -> UC_AssignRoles;
    Admin -> UC_ToggleUserStatus;
    Admin -> UC_DeleteUser;
    Admin -> UC_ViewMetrics;
    Admin -> UC_ViewAuditLogs;
    Admin -> UC_ManageModel;
    Admin -> UC_ToggleModel;
    Admin -> UC_ReviewPredictions;
    
    // AI Engine associations
    AIEngine -> UC_RunInference;
    
    // System associations
    System -> UC_StoreData;
    System -> UC_LogAudit;
    System -> UC_SendNotification;
    
    // Include relationships (dashed lines)
    edge [style=dashed,  fontsize=10];
    UC_UploadImage -> UC_RunInference;
    UC_RunInference -> UC_GetPrediction;
    UC_GetPrediction -> UC_StoreData;
    UC_VerifyPrediction -> UC_LogAudit;
    UC_AssignRoles -> UC_LogAudit;
    UC_ToggleUserStatus -> UC_LogAudit;
    UC_DeleteUser -> UC_LogAudit;
    UC_ToggleModel -> UC_LogAudit;
    UC_VerifyPrediction -> UC_SendNotification;
}
